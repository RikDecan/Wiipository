generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Location {
  id         Int        @id @default(autoincrement())
  city       String     @db.VarChar(100)
  postalCode String     @map("postal_code") @db.VarChar(10)
  province   String     @db.VarChar(50)
  country    String?    @default("België") @db.VarChar(50)
  createdAt  DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  properties Property[]

  @@map("locations")
}

model PropertyType {
  id          Int        @id @default(autoincrement())
  name        String     @unique(map: "name") @db.VarChar(50)
  description String?    @db.Text
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  properties  Property[]

  @@map("property_types")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique(map: "email") @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  dateOfBirth  DateTime?  @map("date_of_birth") @db.Date
  isVerified   Boolean?   @default(false) @map("is_verified")
  createdAt    DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  favorites    Favorite[]
  inquiries    Inquiry[]
  viewings     Viewing[]

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model Agent {
  id              Int        @id @default(autoincrement())
  email           String     @unique(map: "email") @db.VarChar(255)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  phone           String     @db.VarChar(20)
  licenseNumber   String?    @map("license_number") @db.VarChar(50)
  agencyName      String?    @map("agency_name") @db.VarChar(200)
  bio             String?    @db.Text
  profileImage    String?    @map("profile_image") @db.VarChar(500)
  yearsExperience Int?       @default(0) @map("years_experience")
  isActive        Boolean?   @default(true) @map("is_active")
  createdAt       DateTime?  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  properties      Property[]
  viewings        Viewing[]

  @@index([email], map: "idx_agents_email")
  @@map("agents")
}

model Property {
  id             Int             @id @default(autoincrement())
  title          String          @db.VarChar(255)
  description    String?         @db.Text
  propertyTypeId Int             @map("property_type_id")
  locationId     Int             @map("location_id")
  agentId        Int             @map("agent_id")
  address        String          @db.VarChar(255)
  price          Decimal         @db.Decimal(12, 2)
  bedrooms       Int?            @default(0)
  bathrooms      Int?            @default(0)
  areaSqm        Int?            @map("area_sqm")
  gardenSqm      Int?            @default(0) @map("garden_sqm")
  garage         Boolean?        @default(false)
  parkingSpaces  Int?            @default(0) @map("parking_spaces")
  energyLabel    EnergyLabel?    @default(D) @map("energy_label")
  yearBuilt      Int?            @map("year_built")
  status         PropertyStatus? @default(available)
  featured       Boolean?        @default(false)
  viewsCount     Int?            @default(0) @map("views_count")
  createdAt      DateTime?       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  favorites      Favorite[]
  inquiries      Inquiry[]
  propertyType   PropertyType    @relation(fields: [propertyTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "properties_ibfk_1")
  location       Location        @relation(fields: [locationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "properties_ibfk_2")
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "properties_ibfk_3")
  images         PropertyImage[]
  viewings       Viewing[]

  @@index([agentId], map: "idx_properties_agent")
  @@index([locationId], map: "idx_properties_location")
  @@index([price], map: "idx_properties_price")
  @@index([status], map: "idx_properties_status")
  @@index([propertyTypeId], map: "idx_properties_type")
  @@map("properties")
}

model PropertyImage {
  id           Int       @id @default(autoincrement())
  propertyId   Int       @map("property_id")
  imageUrl     String    @map("image_url") @db.VarChar(500)
  altText      String?   @map("alt_text") @db.VarChar(255)
  isPrimary    Boolean?  @default(false) @map("is_primary")
  displayOrder Int?      @default(0) @map("display_order")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "property_images_ibfk_1")

  @@index([propertyId], map: "property_id")
  @@map("property_images")
}

model Viewing {
  id            Int            @id @default(autoincrement())
  propertyId    Int            @map("property_id")
  userId        Int            @map("user_id")
  agentId       Int            @map("agent_id")
  scheduledDate DateTime       @map("scheduled_date") @db.DateTime(0)
  status        ViewingStatus? @default(scheduled)
  notes         String?        @db.Text
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "viewings_ibfk_1")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "viewings_ibfk_2")
  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "viewings_ibfk_3")

  @@index([agentId], map: "agent_id")
  @@index([scheduledDate], map: "idx_viewings_date")
  @@index([propertyId], map: "property_id")
  @@index([userId], map: "user_id")
  @@map("viewings")
}

model Favorite {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  propertyId Int       @map("property_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_ibfk_1")
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_ibfk_2")

  @@unique([userId, propertyId], name: "unique_favorite", map: "unique_favorite")
  @@index([propertyId], map: "property_id")
  @@map("favorites")
}

model Inquiry {
  id         Int            @id @default(autoincrement())
  propertyId Int            @map("property_id")
  userId     Int?           @map("user_id")
  name       String         @db.VarChar(200)
  email      String         @db.VarChar(255)
  phone      String?        @db.VarChar(20)
  message    String         @db.Text
  status     InquiryStatus? @default(new)
  createdAt  DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inquiries_ibfk_1")
  user       User?          @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "inquiries_ibfk_2")

  @@index([propertyId], map: "property_id")
  @@index([userId], map: "user_id")
  @@map("inquiries")
}

enum EnergyLabel {
  A_PLUS_PLUS @map("A++")
  A_PLUS      @map("A+")
  A
  B
  C
  D
  E
  F
  G
}

enum PropertyStatus {
  available
  under_offer
  sold
  withdrawn
}

enum ViewingStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum InquiryStatus {
  new
  replied
  closed
}
